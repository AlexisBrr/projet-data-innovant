    <worksheet name='TDB_usagers_2_1'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontsize='10'>Nombre d&apos;accidents en fonction de la plage horaire cohérente de la journée</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='accidentvelo_nettoye' name='federated.1pkjh040s07j1y1gdptgj1tzt0ic' />
          </datasources>
          <datasource-dependencies datasource='federated.1pkjh040s07j1y1gdptgj1tzt0ic'>
            <column caption='Heures formatées' datatype='datetime' name='[Calculation_1266918914743238659]' role='dimension' type='ordinal'>
              <calculation class='tableau' formula='MAKETIME(INT(LEFT([hrmn], 2)), INT(MID([hrmn], 4, 2)), 0)' />
            </column>
            <column caption='Plage horaire' datatype='string' name='[Calculation_1266918914743529476]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR(DATEPART(&apos;hour&apos;, [Calculation_1266918914743238659])) + &quot;:00 - &quot; + STR(DATEPART(&apos;hour&apos;, [Calculation_1266918914743238659]) + 1) + &quot;:00&quot;' />
            </column>
            <column caption='Num Acc' datatype='string' default-role='measure' default-type='quantitative' name='[Num_Acc]' role='dimension' type='nominal' />
            <column caption='Commune' datatype='string' name='[com]' role='dimension' type='nominal' />
            <column-instance column='[Num_Acc]' derivation='CountD' name='[ctd:Num_Acc:qk]' pivot='key' type='quantitative' />
            <column aggregation='CountD' caption='Heure:Minute' datatype='string' name='[hrmn]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1266918914743529476]' derivation='None' name='[none:Calculation_1266918914743529476:nk]' pivot='key' type='nominal' />
            <column-instance column='[com]' derivation='None' name='[none:com:nk]' pivot='key' type='nominal' />
            <column-instance column='[statut_heure]' derivation='None' name='[none:statut_heure:nk]' pivot='key' type='nominal' />
            <column caption='Statut Heure' datatype='string' name='[statut_heure]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.1pkjh040s07j1y1gdptgj1tzt0ic].[none:com:nk]'>
            <groupfilter function='member' level='[none:com:nk]' member='&quot;38185&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <filter class='categorical' column='[federated.1pkjh040s07j1y1gdptgj1tzt0ic].[none:statut_heure:nk]'>
            <groupfilter function='member' level='[none:statut_heure:nk]' member='&quot;Cohérente&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1pkjh040s07j1y1gdptgj1tzt0ic].[none:statut_heure:nk]</column>
            <column>[federated.1pkjh040s07j1y1gdptgj1tzt0ic].[none:com:nk]</column>
          </slices>
          <aggregation value='true' />
        </view>
